# Host ports are 33000 + offset:
# api 0, website 1, admin 2, postgres 5, mailpit UI 6, adminer 7
# Mailpit SMTP uses 33016 so it does not share the UI port.

# Postgres
POSTGRES_USER=luxurydurbar
POSTGRES_PASSWORD=luxurydurbar
POSTGRES_DB=luxurydurbar
POSTGRES_HOST_PORT=33005

# Mailpit
MAILPIT_SMTP_PORT=33016
MAILPIT_UI_PORT=33006

# Adminer
ADMINER_PORT=33007
