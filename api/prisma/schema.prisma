generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  staff
}

enum BookingStatus {
  pending
  confirmed
  rejected
  cancelled
}

enum EventType {
  wedding
  reception
  birthday
  corporate
  engagement
  anniversary
  bratabandha
  annaprashan
  festival
  other
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(staff)
  resetToken   String?
  resetExpires DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Booking {
  id            String        @id @default(cuid())
  hallSlug      String
  eventDate     DateTime      @db.Date
  startTime     String
  endTime       String
  guestCount    Int
  eventType     EventType
  customerName  String
  customerEmail String
  customerPhone String
  notes         String?
  status        BookingStatus @default(pending)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([hallSlug, eventDate, status])
  @@map("bookings")
}

model BlockedSlot {
  id        String   @id @default(cuid())
  hallSlug  String
  date      DateTime @db.Date
  startTime String
  endTime   String
  reason    String?
  createdAt DateTime @default(now())

  @@index([hallSlug, date])
  @@map("blocked_slots")
}
