# Database (host port 33005 -> container 5432; see services/.env)
DATABASE_URL=postgresql://luxurydurbar:luxurydurbar@localhost:33005/luxurydurbar?schema=public

# API server
API_PORT=33000
JWT_SECRET=change-me-to-a-long-random-secret
JWT_COOKIE_NAME=ld_admin_token
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# CORS / origins
WEBSITE_ORIGIN=http://localhost:33001
ADMIN_ORIGIN=http://localhost:33002
API_ORIGIN=http://localhost:33000

# SMTP (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=33016
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Luxury Durbar <noreply@luxurydurbar.local>"
STAFF_NOTIFY_EMAIL=admin@luxurydurbar.local

# Seed admin
SEED_ADMIN_EMAIL=admin@luxurydurbar.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Admin
